# The snapshot the server reads. Default: the JSON files in ./ontology-data.
# BIBLE_MCP_STORE=json
# BIBLE_MCP_STORE=mongodb

# Where the JSON snapshot lives (absolute or relative to the project root).
# BIBLE_MCP_DATA=./ontology-data

# MongoDB, when BIBLE_MCP_STORE=mongodb. Seed it once with `npm run seed`.
# MONGODB_URI=mongodb://127.0.0.1:27017/bible_mcp
# MONGODB_DB=bible_mcp
