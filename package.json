{
  "name": "bible-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A read-only MCP server over the Bible Ontology graph, built with Next.js and xmcp",
  "keywords": [
    "mcp",
    "xmcp",
    "nextjs",
    "bible",
    "ontology"
  ],
  "scripts": {
    "dev": "xmcp dev & next dev --turbopack",
    "build": "xmcp build && next build",
    "start": "next start",
    "export-data": "python3 scripts/export-ontology-data.py",
    "verify": "node scripts/verify.mjs",
    "announce": "scripts/announce.sh",
    "seed": "node scripts/seed-mongo.mjs",
    "diff": "python3 scripts/reference-diff.py"
  },
  "dependencies": {
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xmcp": "^1.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmcp-dev/compiler": "^1.10.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
